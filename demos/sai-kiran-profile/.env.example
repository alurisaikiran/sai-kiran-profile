# Copy this file to .env.local and fill in real values before running the app.
# Never commit the real .env.local to git.

# Supabase project URL and anon/publishable key.
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-public-key
